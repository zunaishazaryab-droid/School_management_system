# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-schoolmgmt-v2-dev-key-change-in-production-123456
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL by default, falls back to SQLite if DB_ENGINE=sqlite)
DB_ENGINE=sqlite
DB_NAME=school_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Timezone & Localization
TIME_ZONE=Asia/Karachi
LANGUAGE_CODE=en-us
